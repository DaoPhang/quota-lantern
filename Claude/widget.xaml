<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Widget" Width="352" Height="292"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9ACBB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="27"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#30323D"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#30323D"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" Margin="6" Background="#191B24" BorderBrush="#373A47" BorderThickness="1" CornerRadius="22">
    <Grid Margin="20,14,20,14">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Grid x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#x2733;" Foreground="#D97757" FontFamily="Segoe UI Symbol" FontSize="19" FontWeight="Bold" Margin="0,0,9,0"/>
          <TextBlock Text="Claude" Foreground="#F4F5FA" FontSize="17" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="MenuButton" Content="&#x22EF;" ToolTip="Widget options" AutomationProperties.Name="Widget options"/>
        <Button x:Name="CloseButton" Content="&#x00D7;" ToolTip="Close widget" AutomationProperties.Name="Close widget"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="-4,9,-4,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Grid Width="132" Height="132">
            <Ellipse Width="112" Height="112" Stroke="#3A2F2C" StrokeThickness="8"/>
            <Path x:Name="PrimaryArc" Stroke="#E8A07F" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="PrimaryValue" Text="--" Foreground="#F5F7FC" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="remaining" Foreground="#939AAE" FontSize="11" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="5-hour limit" Foreground="#E8A07F" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
          <TextBlock x:Name="PrimaryReset" Text="Waiting for data" Foreground="#9EA5B8" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Grid Width="132" Height="132">
            <Ellipse Width="112" Height="112" Stroke="#2A3340" StrokeThickness="8"/>
            <Path x:Name="WeeklyArc" Stroke="#8FB8E8" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="WeeklyValue" Text="--" Foreground="#F5F7FC" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="remaining" Foreground="#939AAE" FontSize="11" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="1-week limit" Foreground="#8FB8E8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
          <TextBlock x:Name="WeeklyReset" Text="Waiting for data" Foreground="#9EA5B8" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,5,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#9298AC" Margin="0,0,7,0"/>
          <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="#939AAE" FontSize="10" MaxWidth="245" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="RefreshButton" Content="&#x21BB;" HorizontalAlignment="Right" ToolTip="Refresh usage" AutomationProperties.Name="Refresh usage" FontSize="18" Width="24" Height="24"/>
      </Grid>
    </Grid>
  </Border>
</Window>
