<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage Widget" Width="352" Height="292"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="14">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3DFFFFFF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3DFFFFFF"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <!-- Frosted-glass card: translucent dark gradient with a bright top-left rim, like a system widget. -->
  <Border x:Name="Surface" Margin="6" CornerRadius="30" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0343848" Offset="0"/>
        <GradientStop Color="#F01C1E2A" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/></Border.Effect>
    <Grid Margin="20,16,20,14">
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <Grid x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="9" Margin="0,0,9,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7B88FF" Offset="0"/>
                <GradientStop Color="#3D3FB8" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&gt;_" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Codex" Foreground="#F5F5F7" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border CornerRadius="12" Background="#1FFFFFFF" Padding="9,3,10,3" Margin="0,0,8,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9298AC" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusBadge" Text="Connecting" Foreground="#F5F5F7" FontSize="11" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Button x:Name="MenuButton" Content="&#x22EF;" ToolTip="Widget options" AutomationProperties.Name="Widget options" Margin="0,0,4,0"/>
        <Button x:Name="CloseButton" Content="&#x00D7;" ToolTip="Close widget" AutomationProperties.Name="Close widget"/>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- Activity-style rings: outer = 5-hour limit, inner = 1-week limit, both starting at twelve o'clock. -->
        <Canvas x:Name="Gauge" Width="132" Height="132" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Ellipse Canvas.Left="9" Canvas.Top="9" Width="114" Height="114" Stroke="#3379E2BD" StrokeThickness="13"/>
          <Ellipse Canvas.Left="24" Canvas.Top="24" Width="84" Height="84" Stroke="#33B5A2F4" StrokeThickness="13"/>
          <Path x:Name="PrimaryArc" Stroke="#79E2BD" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path x:Name="WeeklyArc" Stroke="#B5A2F4" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <StackPanel Canvas.Left="30" Canvas.Top="46" Width="72">
            <TextBlock x:Name="PrimaryValue" Text="--" Foreground="#F5F5F7" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="LEFT" Foreground="#B8BCCB" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Margin="0,-1,0,0"/>
          </StackPanel>
        </Canvas>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#79E2BD" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="5-hour" Foreground="#79E2BD" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="PrimaryReset" Text="Waiting for data" Foreground="#C4C8D6" FontSize="11" TextWrapping="Wrap" Margin="14,2,0,0"/>
          <Rectangle Height="1" Fill="#24FFFFFF" Margin="0,12,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#B5A2F4" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Weekly" Foreground="#B5A2F4" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="WeeklyValue" Text="--" Foreground="#F5F5F7" FontSize="12" FontWeight="Bold" Margin="6,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="WeeklyReset" Text="Waiting for data" Foreground="#C4C8D6" FontSize="11" TextWrapping="Wrap" Margin="14,2,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,2,0,0">
        <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="#B8BCCB" FontSize="11" MaxWidth="225" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="RefreshButton" Content="&#x21BB;" HorizontalAlignment="Right" ToolTip="Refresh usage" AutomationProperties.Name="Refresh usage" FontSize="16" Width="44" Height="28"/>
      </Grid>
    </Grid>
  </Border>
</Window>
